{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "scc hooks run session-start",
            "statusMessage": "scc",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "scc hooks run stop",
            "statusMessage": "scc",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  }
}
